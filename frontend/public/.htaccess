# ─────────────────────────────────────────────────────────────────────────────
# SPA fallback for Apache / cPanel. Vite copies `public/` verbatim into `dist/`,
# so this ships with every build and cannot be forgotten on an upload.
#
# Goes in the DOCUMENT ROOT that serves `dist/` (e.g. `public_html/`).
# ─────────────────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── The rule that matters most: HANDS OFF THE API. ────────────────────────
  # mod_rewrite rules are NOT inherited into a subdirectory that has no rewrite
  # config of its own, and cPanel's generated Python-app `.htaccess` has none.
  # So without this exclusion the fallback below rewrites `/api/v1/health` to
  # `index.html` and the browser gets 200 text/html where it expected JSON —
  # which surfaces as "Unexpected token '<'" in the SPA, or as a 404, and never
  # as anything that points at this file.
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^/api$
  RewriteRule ^ - [L]

  # Real files and directories are served as-is (hashed JS/CSS bundles, logo).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: hand it the shell. Without this a
  # hard reload on `/students/123` is a web-server 404 — the SPA never loads,
  # so its router never gets the chance to resolve the path.
  RewriteRule ^ index.html [L]
</IfModule>

# ── Never let the browser cache the shell ────────────────────────────────────
# `index.html` names the hashed bundles. A cached shell keeps pointing at the
# PREVIOUS deploy's filenames, which the new upload deleted — so users get a
# blank page with 404s for assets until they clear their cache, and the fix
# looks like a broken deploy rather than a stale document.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Hashed asset filenames change whenever the contents change, so they are safe
  # to cache hard and forever.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Serving the SPA over http drops the `Secure` refresh cookie, which logs every
# user out on each reload. Uncomment once the cPanel AutoSSL certificate is live.
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
