# ─────────────────────────────────────────────────────────────────────────────
# SIS Frontend — environment variables (Vite exposes only VITE_*-prefixed vars).
# Copy to `.env` for local dev. NEVER put secrets here — this is a public SPA.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL the SPA uses for the FastAPI backend (architecture §2/§8.4).
#
# LOCAL DEV (recommended) — use the Vite dev proxy so API calls are SAME-ORIGIN
#   (:5173) and the local SameSite=Lax HttpOnly refresh cookie rides along on the
#   silent-refresh XHR (see vite.config.ts `server.proxy`). Use a RELATIVE base:
#     VITE_API_BASE_URL=/api/v1
#
# LOCAL DEV (direct, no proxy) — point straight at the backend. NOTE: with the
#   backend in ENVIRONMENT=local the refresh cookie is SameSite=Lax and will NOT be
#   sent on this cross-origin (:5173 -> :8000) refresh call, so hard-reload silent
#   refresh will fail. Only use this if you don't need cookie-based refresh.
#     VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# PRODUCTION (Railway) — cross-origin; backend sets SameSite=None; Secure over HTTPS.
#     VITE_API_BASE_URL=https://api.your-school.example/api/v1
VITE_API_BASE_URL=/api/v1

# Public base URL for Supabase Storage assets (D28) — e.g. the school logo used in
# report headers/branding. Public read bucket URL, no key.
# Example: https://<project-ref>.supabase.co/storage/v1/object/public
VITE_SUPABASE_STORAGE_URL=

# Dev-only mock layer (MSW). When "true", the SPA intercepts /auth/* with in-browser
# fixtures so login -> shell -> navigation works WITHOUT a backend. Set to "false" to
# hit the REAL FastAPI backend (required for the auth module + cross-origin cookie test).
# Has no effect in production builds unless explicitly enabled.
VITE_ENABLE_MOCKS=false
