# ─── SIS Backend Environment (architecture.md §8.4) ────────────────────────────
# Copy to `.env` for local development. NEVER commit a real .env.

# MariaDB connection (pymysql driver). The backend targets a self-hosted MariaDB;
# the local example assumes MariaDB on 127.0.0.1:3306, db `sims`, user/pass `sis`.
#
# URL-ENCODE special characters in the password — the value is passed through
# VERBATIM (never decoded) by alembic/env.py and tests/conftest.py, so an unescaped
# character silently truncates the URL and the app connects to the wrong place, or
# not at all:  @ -> %40   # -> %23   / -> %2F   : -> %3A   ? -> %3F
# e.g. password `p@ss/word` becomes  mysql+pymysql://sis:p%40ss%2Fword@host:3306/sims
#
# REQUIRED outside ENVIRONMENT=local — the app refuses to start on this default
# rather than silently connecting to whatever is listening on localhost:3306.
DATABASE_URL=mysql+pymysql://sis:sis@127.0.0.1:3306/sims

# Connection pool. pool_size + max_overflow is the ceiling on concurrent DB
# connections from ONE process; keep (pool_size + max_overflow) * processes well
# under MariaDB's max_connections (default 151).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Recycle pooled connections after this many seconds. MUST stay below MariaDB's
# `wait_timeout` (default 28800) or the pool hands out sockets the server closed.
DB_POOL_RECYCLE=1800
# Seconds a request waits for a free pooled connection before failing.
DB_POOL_TIMEOUT=30

# JWT signing secret — generate a long random value (e.g. `openssl rand -hex 32`).
# REQUIRED in every environment; the app refuses to start with the insecure default
# unless ENVIRONMENT=local.
JWT_SECRET=change-me-in-prod-use-a-32+-byte-random-secret

# Token lifetimes (seconds). Access ~15 min, refresh ~7 days.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Comma-separated explicit CORS allow-list (NEVER "*" with credentials).
# Include the SPA origin(s). Local Vite dev server shown.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Brute-force lockout: failed attempts before a temporary lock.
LOCKOUT_THRESHOLD=5
# Lockout duration once threshold hit (seconds).
LOCKOUT_DURATION=900

# Refresh-session idle timeout (seconds). Refresh refused past this window (FR-AUTH-10).
SESSION_IDLE_TIMEOUT=1800

# Argon2id parameters (argon2-cffi defaults are sensible; tune for the host).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Password policy (FR-AUTH-09): minimum length enforced server-side.
PASSWORD_MIN_LENGTH=10

# ─── Reverse proxy / real client IP (app/core/net.py) ──────────────────────────
# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For header we
# are willing to believe. LEAVE EMPTY when the app is directly exposed.
#
# Empty is the SAFE default: with no trusted proxy, X-Forwarded-For is ignored
# entirely and the address recorded in login_attempts / used by the rate limiter
# is always the real TCP peer, which cannot be forged. Populate this ONLY for
# proxies that actually front the app — anything listed here can dictate the
# client IP the audit trail and the throttle see.
#   nginx/Caddy on the same host:  TRUSTED_PROXIES=127.0.0.1,::1
#   Docker bridge network:         TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=
#
# ⚠ IMPORTANT — DISABLE UVICORN'S OWN PROXY-HEADER LAYER.
# uvicorn enables `--proxy-headers` BY DEFAULT with `--forwarded-allow-ips` of
# "127.0.0.1", so it rewrites the client address from X-Forwarded-For before this
# app sees it whenever the peer is loopback — i.e. exactly the same-host
# nginx/Caddy layout above. TRUSTED_PROXIES is then bypassed and there are two
# trust policies, only one of which you configured. Start the server with:
#
#     uvicorn app.main:app --forwarded-allow-ips=""
#
# This CANNOT be set from this file: uvicorn reads FORWARDED_ALLOW_IPS from the
# real process environment before it imports the app, and pydantic-settings loads
# .env into the app only. Use the CLI flag, or export the variable in the unit
# file / process manager. The app logs `proxy_header_conflict` once if it detects
# the rewrite happening anyway.

# ─── Security headers (app/core/security_headers.py) ───────────────────────────
# HSTS lifetime in seconds. Sent ONLY when ENVIRONMENT != local (HSTS over plain
# http is meaningless and pinning localhost to https breaks other local projects).
# Start LOW (e.g. 300) on a new TLS rollout — HSTS cannot be un-sent from a
# browser that already cached it — then raise to a year once confident.
HSTS_MAX_AGE=31536000
# Comma-separated Host header allow-list; "*" disables the check. Set to the real
# public hostname(s) in production to defeat Host-header poisoning.
TRUSTED_HOSTS=*

# ─── Rate limiting (app/core/ratelimit.py) ─────────────────────────────────────
# IN-PROCESS ONLY: counters are per worker process and are lost on restart. With
# N uvicorn workers the effective limit is N x the value below. See the module
# docstring before scaling out.
RATE_LIMIT_ENABLED=true
# The counters below track FAILED attempts per client IP, NOT total requests — a
# school behind one NAT address must not throttle itself at the 8am bell, and the
# abuse being blocked (password spraying, refresh brute force) is all failures.
RATE_LIMIT_LOGIN_MAX_FAILURES=30
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_REFRESH_MAX_FAILURES=60
RATE_LIMIT_REFRESH_WINDOW=300
# Hard ceiling on tracked client keys (an unbounded per-IP map is itself a DoS).
RATE_LIMIT_MAX_TRACKED_KEYS=10000

# ─── Retention / purge job (`python -m app.jobs.purge`, OQ-DB6) ────────────────
# Nothing runs this automatically — schedule it with cron / systemd timer / the
# platform's scheduler. Use --dry-run first.
RETENTION_LOGIN_ATTEMPTS_DAYS=90
# NOTE: audit_log holds the release-nudge cooldown state. The job refuses to
# delete an in-cooldown nudge row regardless of this value, but setting it below
# a day is still a bad idea.
RETENTION_AUDIT_LOG_DAYS=365
# Days past expiry before a refresh session row is removed.
RETENTION_REFRESH_SESSION_GRACE_DAYS=7
# Rows per DELETE statement (keeps locks short on a live database).
PURGE_BATCH_SIZE=1000

# Environment name: local | staging | production. Controls cookie Secure flag
# relaxation, HSTS emission, and the JWT_SECRET / DATABASE_URL safety checks.
ENVIRONMENT=local

# Seed bootstrap principal (used by the seed migration/script).
SEED_ADMIN_EMAIL=principal@school.local
# If unset, the seed GENERATES a strong temporary password and prints it once.
# SEED_ADMIN_PASSWORD=
