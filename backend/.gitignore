# ── Secrets / environment ────────────────────────────────────────────────────
# NEVER commit a real .env — it will hold the Supabase Postgres connection string
# and JWT secret. Only .env.example (placeholders) is tracked.
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ── Generated demo-seed artifacts (D31 Phase 5) ──────────────────────────────
# `db/mariadb/seed_demo.py` writes both of these on every run. NEITHER may be
# tracked: one holds the plaintext logins, the other the per-account Argon2 hashes
# of those same passwords. The pre-D31 `010_seed_demo.sql` WAS tracked and carried
# one hardcoded password shared by 19 accounts, so rotating the constant in the
# script never fixed the checked-in file. Re-generate; never copy.
db/mariadb/generated/

# ── Schema backups (D32) ─────────────────────────────────────────────────────
# `apply_sql.py --backup <file>` writes a SHOW CREATE TABLE snapshot of the live
# database before a migration. Operator artefacts, one per run: they pin a moment in
# a particular environment, so a tracked copy would go stale immediately and read as
# authoritative when it is not. `sims.sql` is the tracked baseline.
db/mariadb/pre_*.sql
db/mariadb/*_backup.sql

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
